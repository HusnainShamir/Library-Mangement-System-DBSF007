@{
    ViewData["Title"] = "Dashboard";
}

<h1>Library Management Dashboard</h1>

<div class="row">

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Books</h5>
                <h2>@ViewBag.TotalBooks</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Authors</h5>
                <h2>@ViewBag.TotalAuthors</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Categories</h5>
                <h2>@ViewBag.TotalCategories</h2>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Publishers</h5>
                <h2>@ViewBag.TotalPublishers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Users</h5>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card m-2">
            <div class="card-body">
                <h5>Total Members</h5>
                <h2>@ViewBag.TotalMembers</h2>
            </div>
        </div>
    </div>

</div>