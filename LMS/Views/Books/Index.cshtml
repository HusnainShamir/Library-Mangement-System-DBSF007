@model List<LMS.Models.Book>

<h2>Books List</h2>

<a href="/Books/Create" class="btn btn-primary">Add New Book</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>ISBN</th>
            <th>Year</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    @foreach (var book in Model)
    {
        <tr>
            <td>@book.BookID</td>
            <td>@book.Title</td>
            <td>@book.ISBN</td>
            <td>@book.PublishYear</td>

            <td>
                <a href="/Books/Edit/@book.BookID" class="btn btn-warning">Edit</a>
                <a href="/Books/Delete/@book.BookID" class="btn btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>